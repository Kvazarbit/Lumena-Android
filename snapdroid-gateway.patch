+
+import java.net.Inet4Address;
+import java.net.InetAddress;
+
+/** Resolves the IPv4 router of the currently connected Wi-Fi network. */
+public final class WifiGatewayResolver {
+    public static final int STREAM_PORT = 1704;
+    public static final int CONTROL_PORT = 1705;
+
+    private WifiGatewayResolver() {
+    }
+
+    public static String resolve(Context context) {
+        if (context == null)
+            return null;
+
+        ConnectivityManager manager =
+                (ConnectivityManager) context.getApplicationContext()
+                        .getSystemService(Context.CONNECTIVITY_SERVICE);
+        if (manager == null)
+            return null;
+
+        // Prefer Android's active network, but also inspect all Wi-Fi networks.
+        // The latter matters when Android keeps mobile data as the default route
+        // while connected to a hotspot that has temporarily lost internet access.
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
+            String gateway = resolve(manager, manager.getActiveNetwork());
+            if (!TextUtils.isEmpty(gateway))
+                return gateway;
+        }
+
+        for (Network network : manager.getAllNetworks()) {
+            String gateway = resolve(manager, network);
+            if (!TextUtils.isEmpty(gateway))
+                return gateway;
+        }
+        return null;
+    }
+
+    private static String resolve(ConnectivityManager manager, Network network) {
+        if (network == null)
+            return null;
+
+        NetworkCapabilities capabilities = manager.getNetworkCapabilities(network);
+        if ((capabilities == null) ||
+                !capabilities.hasTransport(NetworkCapabilities.TRANSPORT_WIFI))
+            return null;
+
+        LinkProperties properties = manager.getLinkProperties(network);
+        if (properties == null)
+            return null;
+
+        // A default IPv4 route is the hotspot/router address we need.
+        for (RouteInfo route : properties.getRoutes()) {
+            InetAddress gateway = route.getGateway();
+            if (route.isDefaultRoute() && (gateway instanceof Inet4Address))
+                return gateway.getHostAddress();
+        }
+
+        // Defensive fallback for vendor-specific route tables.
+        for (RouteInfo route : properties.getRoutes()) {
+            InetAddress gateway = route.getGateway();
+            if (gateway instanceof Inet4Address)
+                return gateway.getHostAddress();
+        }
+        return null;
+    }
+}
